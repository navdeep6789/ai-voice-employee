# ==============================================================================
# AI Voice Employee - Environment Configuration
# Open Source Voice Agent Platform Template
# ==============================================================================

# Gemini API Configuration (Backend ONLY - NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Backend Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://127.0.0.1:3000","http://127.0.0.1:8000","http://localhost:3000","http://localhost:8000"]

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./ai_voice_employee.db
DATABASE_SYNC_URL=sqlite:///./ai_voice_employee.db

# RAG & Embeddings
EMBEDDING_PROVIDER=local
KNOWLEDGE_DIR=../../data/knowledge

# Agent Safety & Rate Limiting
MAX_TOOL_CALLS_PER_TURN=5
MAX_CONVERSATION_DURATION_SECONDS=900
RATE_LIMIT_MESSAGES_PER_MINUTE=60
